<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_report_password_wizard_form" model="ir.ui.view">
            <field name="name">report.password.wizard.form</field>
            <field name="model">report.password.wizard</field>
            <field name="arch" type="xml">
                <form string="Contraseña del Reporte">
                    <div class="alert alert-info" role="alert">
                        <strong>Acceso Restringido:</strong> Ingrese la contraseña para acceder al Reporte-Z
                    </div>
                    <group>
                        <field name="session_id" invisible="1"/>
                        <field name="password" password="True" placeholder="Ingrese la contraseña..."/>
                    </group>
                    <footer>
                        <button name="validate_password_and_print" type="object" 
                                string="Generar Reporte" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_report_password_wizard" model="ir.actions.act_window">
            <field name="name">Contraseña del Reporte</field>
            <field name="res_model">report.password.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
